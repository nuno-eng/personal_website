# Copy to .env and fill in. Never commit .env.
RESEND_API_KEY=
# Resend > Audience > Segments. (An old Audience id works too: Resend migrated them to segments.)
RESEND_SEGMENT_ID=
# "Display Name <you@yourverifieddomain.com>" - must be on a domain verified in Resend.
RESEND_FROM="Nuno Fontoura <nuno@news.nunofontoura.com>"
# Where replies go. Optional.
RESEND_REPLY_TO=info@nabiaedge.com
# `npm run send:test` sends the issue only to this address.
TEST_EMAIL=info@nabiaedge.com
